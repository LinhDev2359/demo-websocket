# =================================
# EOS WALLET SYSTEM - ENVIRONMENT VARIABLES
# =================================
# Copy this file to .env and update the values
# NEVER commit .env file to git!

# Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=wallet_system
MYSQL_USER=your_db_username
MYSQL_PASSWORD=your_secure_db_password

# Application Database Connection
DATABASE_URL=jdbc:mysql://mysql:3306/wallet_system?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_secure_db_password

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security

# EOS Blockchain API
EOS_API_URL=https://eos.greymass.com

# Application Environment
ENVIRONMENT=dev
SERVER_PORT=8080

# Docker Network
COMPOSE_PROJECT_NAME=wallet-system

# Monitoring (Optional)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password